# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only. Never expose this in the browser. Supabase settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# GA4 automatic sync (Traffic page) — OPTIONAL fallback. The normal way is the
# Settings page "Google Analytics 4 (API)" card (property ID + service-account
# JSON pasted there, stored in app_settings). These env vars are only used when
# that card is empty. GOOGLE_SA_PRIVATE_KEY accepts "\n" escapes.
GA4_PROPERTY_ID=123456789
GOOGLE_SA_EMAIL=name@project.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
